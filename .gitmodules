# Generated by .github/scripts/repo-index.ts from the GitHub repository

# list. Do not edit by hand; changes are overwritten by the next sync.

# Lifecycle: active/public at category root; active/private under _private/;

# archived/public under _archive/; archived/private under _archive/_private/.

# Categories: data-* -> _data/, template-* -> _templates/,

# agents-* -> _agents/, all others at the umbrella root.

# Special case: data-agents -> .agents at the umbrella root.

# Run node .github/scripts/sync-workspace.ts --dry-run to preview.

